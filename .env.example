# Corrector CARM - plantilla local
# Copia este archivo a .env y rellena solo lo necesario.
# No subas .env al repositorio.

# Credenciales CARM
CARM_USUARIO=tu_usuario_carm
CARM_CONTRASENA=tu_contrasena_carm
CARM_RECORDAR_CUENTA=1

# Navegacion CARM
CARM_DASHBOARD_URL=https://formacion.carm.es/my/index.php
CARM_COURSE_URL=
CARM_COURSE_END_DATE=
CARM_HEADLESS=0
CARM_NAV_TIMEOUT_MS=90000

# Correccion
# api: corrige automaticamente con OPENAI_API_KEY.
# prompt: genera prompts para resolver fuera e importar JSON.
CORRECTION_MODE=prompt

# OpenAI API, opcional si usas Codex/ChatGPT manualmente
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PROMPT_TOKEN_WARN=100000
OPENAI_PROMPT_TOKEN_MAX=180000

# Codex CLI, opcional si la app de bandeja no lo encuentra en PATH
# CODEX_CLI_PATH=C:\Users\tu_usuario\.vscode\extensions\openai.chatgpt-...\bin\windows-x86_64\codex.exe

# Retencion local
LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
