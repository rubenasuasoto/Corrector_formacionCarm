# Credenciales de CARM Formación
CARM_USUARIO=tu_usuario_carm
CARM_CONTRASENA=tu_contrasena_carm

# API Key de OpenAI. Necesaria para el flujo recomendado por API.
OPENAI_API_KEY=tu_api_key_aqui

# Modelo para el flujo por API. gpt-5-mini es el valor recomendado por coste/velocidad.
OPENAI_MODEL=gpt-5.4-mini

# api: corrige automaticamente con OPENAI_API_KEY.
# prompt: genera prompts para pegarlos manualmente en Codex/ChatGPT y luego importar el JSON.
CORRECTION_MODE=prompt

# Opcional: ruta absoluta a Codex CLI si la app de bandeja no lo encuentra en PATH.
# CODEX_CLI_PATH=C:\Users\tu_usuario\.vscode\extensions\openai.chatgpt-...\bin\windows-x86_64\codex.exe

# Opcional: area personal para detectar todos los cursos visibles
CARM_DASHBOARD_URL=https://formacion.carm.es/course/my/index.php

# Opcional: URL del curso activo. La interfaz la cambia al elegir un curso.
CARM_COURSE_URL=https://formacion.carm.es/course/view.php?id=1592

# Opcional: fecha de fin del curso. Si ya pasó, la cache local se borra al iniciar.
CARM_COURSE_END_DATE=2026-06-02
